diff --git a/supabase/tests/0154_site_capability_authority/authority-lifecycle-workspace-session.sql b/supabase/tests/0154_site_capability_authority/authority-lifecycle-workspace-session.sql
new file mode 100644
index 00000000..92c5f40c
--- /dev/null
+++ b/supabase/tests/0154_site_capability_authority/authority-lifecycle-workspace-session.sql
@@ -0,0 +1,24 @@
+\set ON_ERROR_STOP on
